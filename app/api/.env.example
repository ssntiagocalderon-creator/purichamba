# Copiar a .env y ajustar. .env no se sube a git.

# Postgres con pgvector (lo levanta app/docker-compose.yml)
DATABASE_URL=postgres://postgres:dev@localhost:5432/pasaporte

PUERTO=3000
# Para probar desde un celular en la misma red wifi, cambiar a 0.0.0.0
HOST=127.0.0.1

# Clave de la demo. OBLIGATORIA si se expone con ngrok (Tether pidió autenticación en el endpoint).
# El navegador pide usuario y clave una vez; el usuario puede ser cualquiera. Vacía = sin clave.
ACCESO_CLAVE=

# Modo de la IA:
#   qvac   -> usa @qvac/sdk en este mismo proceso (Mac con GPU recomendada)
#   sin_ia -> similitud léxica y reglas, para desarrollar sin descargar modelos
IA_MODO=sin_ia

# Qué hace cada paso con IA_MODO=qvac (D-056, recomendación de Tether en la mentoría del 27-10):
#   PROPUESTAS:    decision -> modelo de decisión Laya propone las competencias de la persona (rápido)
#                  llm      -> Qwen local con JSON Schema (más lento)
#   EQUIVALENCIAS: decision   -> Laya juzga cada par de competencias ("¿son la misma tarea?")
#                  embeddings -> EmbeddingGemma + UMBRAL_EMBEDDINGS
#   EXPLICACION:   tether    -> servidor delegado de Tether (necesita TETHER_URL y TETHER_TOKEN)
#                  local     -> Qwen local
#                  plantilla -> texto fijo, sin IA
# El porcentaje nunca lo da la IA: es la fórmula fija "tienes X de Y competencias" (D-052).
PROPUESTAS=decision
EQUIVALENCIAS=decision
EXPLICACION=plantilla

# Modelos de QVAC (constantes del SDK v0.22)
# Modelo de decisión: LAYA_MULTILINGUAL_322M_Q8_0 (multilingüe) o LAYA_421M_Q8_0 (para comparar).
QVAC_MODELO_DECISION=LAYA_MULTILINGUAL_322M_Q8_0
# cpu o gpu
QVAC_DISPOSITIVO_DECISION=cpu
QVAC_MODELO_EMBEDDINGS=EMBEDDINGGEMMA_300M_Q8_0
QVAC_MODELO_LLM=QWEN3_4B_INST_Q4_K_M
# Voz a texto (D-003). Si no carga, la app sigue funcionando por texto.
QVAC_MODELO_VOZ=PARAKEET_TDT_0_6B_V3_Q8_0

# Umbrales. POR CALIBRAR con npm run qvac:probar (usa los pares de datos/equivalencias.csv).
# Las equivalencias validadas por el equipo (datos/equivalencias.csv) siempre mandan sobre el umbral.
# Probabilidad de Laya para "las dos competencias son la misma tarea":
UMBRAL_DECISION=0.5
# Probabilidad de Laya para "la persona hace esta tarea":
UMBRAL_PROPUESTA=0.5
UMBRAL_EMBEDDINGS=0.6
UMBRAL_LEXICO=0.4

# Servidor delegado de Tether (compatible con OpenAI). El token va SOLO aquí, en .env:
# nunca en código, commits, capturas ni chats. Ver el nombre del modelo con: npm run tether:probar
# Con EXPLICACION=tether solo se envían nombres de ocupaciones y textos oficiales, nunca el relato de la persona.
TETHER_URL=
TETHER_TOKEN=
TETHER_MODELO=
TETHER_TIMEOUT_MS=30000
